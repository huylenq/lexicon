{
  "name": "lexicon-viewer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:icons": "bun scripts/generate-icons.ts",
    "start": "bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun server/cli.ts check",
    "convert": "bun server/cli.ts convert",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.11.0",
    "elkjs": "0.11.1",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "4.0.1",
    "tree-sitter": "0.21.1",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "xast-util-from-xml": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "trustedDependencies": [
    "esbuild",
    "tree-sitter",
    "tree-sitter-python",
    "tree-sitter-typescript"
  ]
}
