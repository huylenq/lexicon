# lexicon/system.yaml — the cold-layer root file.
# Holds: shared kernels (named cross-context coordination), contexts index,
# overlays, deliberate omissions. Per-context entries live in
# lexicon/contexts/<slug>.yaml. Soft ceiling: ~500 lines.

schemaVersion: "0.3"
kind: system
id: <project-slug>
name: <Project name>

purpose: |
  One paragraph: what this system does, for whom.

# Index of bounded contexts. Each slug either matches a file under
# lexicon/contexts/<slug>.yaml (when the context owns ≥3 entries) or is
# index-only (small contexts that don't merit their own file yet).
contexts:
  - <context-slug>
  - <other-context-slug>

# Shared kernels: named shared sub-models across ≥2 contexts that the
# contexts deliberately coordinate on (not just happen to use). The
# replacement for v0.2's `crossCuttingTerms` / `crossCuttingInvariants`.
sharedKernels:
  - id: <kernel-slug>
    name: <Display name>
    description: |
      What this kernel covers; what coordination it demands across the
      participating contexts.
    participatingContexts:
      - <context-slug>
      - <other-context-slug>
    rationale: |
      Why these contexts share this model rather than each owning their
      own or routing through an anticorruption layer.
    terms:
      - id: <term-slug>
        name: <Display name>
        category: value          # entity | value | service | event | concept
        definition: |
          A short definition. Honest about what the term means; honest about
          what it does not mean.
        equality: |              # value-category only
          When two instances are interchangeable.
    invariants:
      - id: <invariant-slug>
        name: <Display name>
        statement: |
          The property that must hold across the kernel.
        rationale: |
          Why it matters; what breaks when it's violated.

# Topics deliberately not in the model, with reasons. Anti-content: marks
# the boundary by naming what's intentionally outside.
deliberateOmissions:
  - topic: <Short topic>
    reason: |
      Why this is intentionally not specified.
