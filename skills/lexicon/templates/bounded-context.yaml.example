# lexicon/contexts/<slug>.yaml — one bounded context's owned vocabulary.
# Holds: terms, invariants, seams, boundary rules, aggregates, modules
# (Evans-sense concept clusters) owned by this context. Shared sub-models
# across contexts live as `sharedKernels` on lexicon/system.yaml.

schemaVersion: "0.3"
kind: bounded-context
id: <context-slug>            # must match this file's filename slug
name: <Display name>

# Optional: core | supporting | generic. Where this context sits in the
# project's strategic landscape (Evans' subdomain classification).
subdomain: core

purpose: |
  One paragraph: what this context is for, what it owns conceptually.

# Optional: directory globs or paths in the codebase that this context owns.
# Used by audit to verify the context-to-code mapping. Renamed from `modules`
# in v0.3 to free the `modules` name for Evans-sense concept clusters below.
codeModules:
  - src/<module>/**

terms:
  - id: <term-slug>
    name: <Display name>
    category: entity            # entity | value | service | event | concept
    definition: |
      Short definition.
    disambiguatesFrom:
      - <ref>
    symbols:
      - file: src/<module>/foo.ts
        symbol: ClassName
    # Category-specific fields (optional; render when present):
    identityRule: |             # entity only — what gives an instance identity
      Stable identifier rule.

  - id: <value-slug>
    name: <Display>
    category: value
    definition: |
      ...
    equality: |
      When two instances are interchangeable.

  - id: <service-slug>
    name: <Display>
    category: service
    definition: |
      A stateless domain operation.
    operatesOn:
      - <term-ref>
    returns: |
      What the operation produces.

  - id: <event-slug>
    name: <Display>
    category: event
    definition: |
      A fact that happened, named in past tense.
    emittedWhen: |
      The triggering condition.
    payload: |
      What the event carries.
    consumers:
      - <context-ref-or-service-term-ref>

invariants:
  - id: <invariant-slug>
    name: <Display name>
    statement: |
      The property that must hold.
    rationale: |
      Why it matters; what breaks if violated.
    validationMode: code        # OR: linter, principle
    constrainsCode:
      - file: src/<module>/foo.ts
        lineStart: 100
        lineEnd: 140
        symbol: relevantFunction

seams:
  - id: <seam-slug>
    name: <Display name>
    # One of: shared-kernel, customer-supplier, conformist,
    # anticorruption-layer, open-host-service, published-language,
    # partnership, separate-ways. Use `unknown` only when genuinely untriaged.
    kind: anticorruption-layer
    description: |
      A structural joint between modules or contexts. Distinct from a
      boundary rule — a seam is structural, a rule is normative.
    rationale: |
      Why this kind, why this direction.
    # Asymmetric kinds (customer-supplier, conformist, anticorruption-layer,
    # open-host-service) carry upstream + downstream:
    upstream: <other-context-slug>
    downstream: <this-context>
    # Symmetric kinds (shared-kernel, published-language, partnership,
    # separate-ways) carry participants instead of upstream/downstream.

boundaryRules:
  - id: <rule-slug>
    rule: |
      A directional normative rule.
      Example: "Inference never writes to the training store."
    from: <this-context>
    to: <other-context>
    rationale: |
      Why this rule.

aggregates:
  - id: <aggregate-slug>
    name: <Display>
    root: <term-ref>            # must be an entity-category term
    members:                    # entities + value terms inside the boundary
      - <term-ref>
    invariants:                 # the transactional invariants
      - <invariant-ref>
    rationale: |
      Why this cluster, why this root.

# Evans-sense concept clusters within this context. Use when a context has
# enough atoms that natural subgroups are worth naming. Skip otherwise.
modules:
  - id: <module-slug>
    name: <Display>
    description: |
      The cohesion that holds these atoms together.
    members:
      - <ref>
